# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# By default the app persists to a local SQLite file (.data/food-list.db), which
# requires no credentials and is what `npm run setup` seeds with demo data.
DATABASE_DRIVER=sqlite
SQLITE_PATH=.data/food-list.db

# To use Postgres / Supabase instead, set DATABASE_DRIVER=postgres and provide a
# connection string. Supabase: Project → Connect → "Connection string" (session
# pooler on port 5432, or the direct connection string).
# DATABASE_DRIVER=postgres
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# DATABASE_SSL=true

# ---------------------------------------------------------------------------
# Places provider (Google Places API "New")
# ---------------------------------------------------------------------------
# auto = use Google when GOOGLE_PLACES_API_KEY is set, otherwise the built-in
# seeded Cyprus demo provider.
PLACES_PROVIDER=auto
# GOOGLE_PLACES_API_KEY=
# Region/country bias for place search.
PLACES_REGION_CODE=CY
# Optional: simulate provider latency (ms) and failures in the demo provider.
# MOCK_PLACES_LATENCY_MS=0
# MOCK_PLACES_FAILURE_RATE=0

# ---------------------------------------------------------------------------
# Auth / sessions
# ---------------------------------------------------------------------------
# 32+ character secret used to salt session tokens. Required in production —
# the app refuses to create sessions without it when NODE_ENV=production.
# Generate one with: openssl rand -base64 32
SESSION_SECRET=dev-only-session-secret-change-me-please

# ---------------------------------------------------------------------------
# Deployment
# ---------------------------------------------------------------------------
# Only used by the Docker image build, which needs Next.js "standalone" output.
# Netlify builds the default output, so leave this unset there.
# BUILD_TARGET=docker

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Demo mode seeds a shared, read-only-ish demo account that can be signed into
# with one click (see README).
DEMO_MODE=true
